<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The engine's identity and its paired devices stay on this phone: restored
     elsewhere, two phones would be one engine. The artwork cache is made again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="identity.key" />
        <exclude domain="root" path="pairing.json" />
        <exclude domain="root" path="art" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="identity.key" />
        <exclude domain="root" path="pairing.json" />
        <exclude domain="root" path="art" />
    </device-transfer>
</data-extraction-rules>
